---
layout: base.njk
permalink: /blog/
title: Blog
breadcrumbTitle: Blog
description: Engineering notes and research essays by Sundeep Dawadi on low-resource NLP, tokenization, edge AI and Devanagari language technologies.
---
{% include "partials/breadcrumb.njk" %}
<!-- inner-blog -->
<section class="inner-blog pt-120 pb-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title p-relative mb-50 pl-60">
                    <h6>Insights</h6>
                    <h1>Blog &amp; Insights</h1>
                    <p>Engineering notes on quantization, tokenization, and low-resource language methodologies.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-8">
                {% for post in collections.posts %}
                <div class="bsingle__post mb-50">
                    <div class="bsingle__post-thumb">
                        <a href="{{ post.url }}"><img src="/img/ph/blog-cover-wide.svg" alt="{{ post.data.title }} (cover placeholder)"></a>
                    </div>
                    <div class="bsingle__content">
                        <div class="meta-info">
                            <ul>
                                <li><i class="fas fa-user"></i> {{ post.data.author or site.author }}</li>
                                <li><i class="fas fa-calendar-alt"></i> {{ post.data.pubDate | readableDate }}</li>
                                {% if post.data.readTime %}
                                <li><i class="fas fa-clock"></i> {{ post.data.readTime }}</li>
                                {% endif %}
                            </ul>
                        </div>
                        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
                        <p>{{ post.data.description }}</p>
                        <div class="blog__btn">
                            <a href="{{ post.url }}" class="btn">Read More</a>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="bsingle__post mb-50">
                    <div class="bsingle__content">
                        <h2>No posts yet</h2>
                        <p>New articles are on the way. Check back soon.</p>
                    </div>
                </div>
                {% endfor %}
            </div>
            <div class="col-sm-12 col-md-12 col-lg-4">
                <aside class="sidebar-widget">
                    <section class="widget widget_text">
                        <h2 class="widget-title">About</h2>
                        <div class="textwidget">
                            <p>Notes on NLP research, quantization, tokenization and shipping ML to the edge — by {{ site.name }}.</p>
                        </div>
                    </section>
                    <section class="widget widget_categories">
                        <h2 class="widget-title">Tags</h2>
                        <ul>
                            {% for tag in collections.tagList %}
                            <li class="cat-item"><a href="/tags/{{ tag | slugifyTag }}/">{{ tag }}</a></li>
                            {% endfor %}
                        </ul>
                    </section>
                    <section class="widget widget_recent_entries">
                        <h2 class="widget-title">Recent Posts</h2>
                        <ul>
                            {% for post in collections.posts | head(5) %}
                            <li>
                                <a href="{{ post.url }}">{{ post.data.title }}</a>
                                <span class="post-date">{{ post.data.pubDate | readableDate }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </section>
                    <section class="widget_text widget widget_custom_html">
                        <h2 class="widget-title">Follow</h2>
                        <div class="textwidget custom-html-widget">
                            <div class="widget-social">
                                {% for s in site.socials %}
                                <a href="{{ s.url }}" title="{{ s.name }}" target="_blank" rel="noopener noreferrer"><i class="{{ s.icon }}"></i></a>
                                {% endfor %}
                            </div>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </div>
</section>
<!-- inner-blog-end -->
{% include "partials/scrollbox.njk" %}
{% include "partials/contact.njk" %}
