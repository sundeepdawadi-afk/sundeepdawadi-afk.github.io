<!-- footer -->
<footer class="footer-bg footer-p" id="contact-footer">
    <div class="footer-top p-relative fix">
        <div class="container">
            <div class="anim-01"></div>
            <div class="anim-02"></div>
            <div class="row justify-content-center align-items-center">
                <div class="col-xl-6 col-lg-7 col-sm-12 text-center">
                    <div class="section-title p-relative mb-50 wow fadeInLeft" data-animation="fadeInLeft" data-delay=".4s">
                        <div class="f-logo">
                            <span class="site-logo">{{ site.name }}</span>
                        </div>
                        <p>{{ site.tagline }} — building open tools for Nepali &amp; Indic languages and edge intelligence.</p>
                    </div>
                    <div class="footer-social mt-10 mb-120">
                        {% for s in site.socials %}
                        <a href="{{ s.url }}" title="{{ s.name }}" target="_blank" rel="noopener noreferrer"><i class="{{ s.icon }}"></i></a>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="row justify-content-between pt-30 fbtd">
                <div class="col-xl-3 col-lg-3 col-sm-6">
                    <div class="footer-widget mb-30">
                        <div class="f-contact2">
                            <span>Email</span>
                            <h4><a href="mailto:{{ site.email }}">{{ site.email }}</a></h4>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-sm-6">
                    <div class="footer-widget mb-30">
                        <div class="f-contact2">
                            <span>Based In</span>
                            <h4>{{ site.location }}</h4>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-sm-6">
                    <div class="footer-widget mb-30">
                        <div class="f-contact2">
                            <span>Focus</span>
                            <h4>Low-Resource NLP &amp; Edge AI</h4>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-sm-6">
                    <div class="footer-widget mb-30">
                        <div class="f-contact2">
                            <span>Open To</span>
                            <h4>Research Collaborations</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="copyright-wrap">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-12">
                    <div class="copy-text text-center">
                        &copy; {% year %} {{ site.name }}. All rights reserved.
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
<!-- footer-end -->
