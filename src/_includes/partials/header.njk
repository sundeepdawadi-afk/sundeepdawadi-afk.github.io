<!-- header -->
<header class="header-area header-one">
    <div id="header-sticky" class="menu-area">
        <div class="container">
            <div class="second-menu second-menu2">
                <div class="row align-items-center">
                    <div class="col-lg-3 col-md-12">
                        <div class="logo">
                            <a href="/" class="site-logo">{{ site.name }}</a>
                        </div>
                    </div>
                    <div class="col-xl-7 col-lg-7 text-center">
                        <div class="main-menu">
                            <nav id="mobile-menu" style="display: block;">
                                <ul>
                                    {% for item in nav %}
                                    <li{% if (page.url == item.href) or (item.href != "/" and page.url.startsWith(item.href)) %} class="current"{% endif %}>
                                        <a href="{{ item.href }}">{{ item.label }}</a>
                                    </li>
                                    {% endfor %}
                                </ul>
                            </nav>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-2 text-right d-none d-lg-block">
                        <a href="{{ site.navCta.href }}" class="btn ss-btn">{{ site.navCta.label }}</a>
                    </div>
                    <div class="col-12">
                        <div class="mobile-menu"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- header-end -->
